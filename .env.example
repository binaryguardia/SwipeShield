# SentinelWAF — environment configuration (copy to .env and adjust)

# --- Core proxy ---
# Comma-separated listen addresses. TLS/HTTP3 are enabled when cert paths are set.
LISTEN_ADDRS=:8080
LISTEN_ADDRS_TLS=:8443
LISTEN_ADDRS_HTTP3=:8443

# TLS 1.3 certificate/key (required for TLS/HTTP3 listeners)
TLS_CERT_PATH=
TLS_KEY_PATH=

# mTLS (zero-trust). If CLIENT_CA_CERT_PATH is set, clients must present a
# certificate signed by this CA.
CLIENT_CA_CERT_PATH=

# Config file locations (JSON/YAML)
CONFIG_FILE=config.json
RULES_DIR=rules

# --- Fail-open/closed policy ---
# Valid per module. Core rule engine is fail-closed by default.
RULE_ENGINE_FAIL_MODE=closed
LLM_PROTECTION_FAIL_MODE=open
ML_SCORING_FAIL_MODE=open

# --- Auth (Management API) ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD_HASH= # argon2id hash; generated by `sentinelwaf hash --password`

# --- Event pipeline ---
EVENT_LOG_PATH=data/events.log
WEBHOOK_URL=
WEBHOOK_SCHEMA=wazuh

# --- Rate limiting ---
# Use the in-memory backend unless REDIS_ADDR is set.
RATE_LIMIT_BACKEND=memory
REDIS_ADDR=
REDIS_PASSWORD=

# --- Optional services ---
ML_SERVICE_URL=http://127.0.0.1:8501
LLM_PROTECTION_URL=
FINGERPRINT_DB_URL=

# --- WASM plugins ---
WASM_PLUGINS_DIR=wasm-plugins-examples
WASM_PLUGIN_TIMEOUT=100ms

# --- Dashboard ---
DASHBOARD_PORT=5173
